# Налаштування локального запуску. Скопіюйте в .env і впишіть власні ключі.
# Файл .env НІКОМУ не комітиться (див. .gitignore).

# Провайдер AI-компонента: openai | openrouter
ROUTE_LLM_PROVIDER=openrouter
# Ідентифікатор моделі. Перевірено: ця модель повертає коректний JSON із response_format.
ROUTE_LLM_MODEL=minimax/minimax-m3.1-flash:free
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Таймаут одного виклику моделі, секунди
ROUTE_LLM_TIMEOUT=20
# Максимальна кількість спроб (перша + retry) для retryable-збоїв
ROUTE_LLM_MAX_ATTEMPTS=2

# Режим AI-компонента:
#   live    — реальний виклик провайдера
#   stub    — підготовлені відповіді з файлу ROUTE_LLM_STUB (для детермінованих перевірок)
#   offline — імітація недоступності моделі
ROUTE_LLM_MODE=live
# Шлях до JSON-файлу з підготовленими відповідями (потрібен лише для ROUTE_LLM_MODE=stub)
ROUTE_LLM_STUB=stubs/responses.json

# Шлях до файлу сховища. Для окремого тестового проходу вкажіть інший шлях.
ROUTES_DB=data/routes.json
